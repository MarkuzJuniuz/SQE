{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SQE: run app",
      "type": "debugpy",
      "request": "launch",
      "module": "sqe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SQE: run app (AI test)",
      "type": "debugpy",
      "request": "launch",
      "module": "sqe",
      "args": [
        "--ai-test"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SQE: run app (full map)",
      "type": "debugpy",
      "request": "launch",
      "module": "sqe",
      "args": [
        "--full-map"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SQE: run app (AI test + full map)",
      "type": "debugpy",
      "request": "launch",
      "module": "sqe",
      "args": [
        "--ai-test",
        "--full-map"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SQE: run app (AI test + late SEAD: hold test)",
      "type": "debugpy",
      "request": "launch",
      "module": "sqe",
      "args": [
        "--ai-test",
        "--late-sead"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "SQE: smoke test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/smoke_test.py",
      "console": "integratedTerminal"
    }
  ]
}
